<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings><Nullable>enable</Nullable><PlatformTarget>x64</PlatformTarget>
    <Copyright>Copyright (C) 2026 Bernd Spieth and DALIZO contributors</Copyright><PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <AssemblyName>DALIZO</AssemblyName><Title>DALIZO</Title><Product>DALIZO</Product><Description>Desktop Access Layer for Infrastructure Zones and Operations</Description><ApplicationIcon>Assets\Dalizo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="SpiceHost.Input.cs;SpiceHost.Clipboard.cs;SpiceHost.Resize.cs;SpiceHost.RenderingTest.cs" />
    <Resource Include="Assets\Dalizo.ico" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <Content Include="Web\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>


